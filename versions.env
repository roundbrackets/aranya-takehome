# Pinned versions for a reproducible build.
# VERIFY each tag against upstream before a fresh run (see runbook §Preflight).

# Kubespray release tag (checked out fresh by the runbook).
# NOTE: v2.31.0 cited by plan; confirm it is the latest stable tag at run time.
KUBESPRAY_VERSION=v2.31.0

# Kubernetes version: leave empty to use the kubespray default for the tag above.
# Only pin if we deliberately override.
KUBE_VERSION=

# Argo CD (installed from the pinned release manifest). Confirmed latest stable.
ARGOCD_VERSION=v3.4.5

# clusterdOS revision (Argo CD Application targetRevision + clusterdos.ref).
CLUSTERDOS_REVISION=v0.3.26

# Optional GitApp: kube-state-metrics — built into clusterdOS as gitapp key `ksm`.
# No separate pin needed; version tracked by the clusterdOS release above.
